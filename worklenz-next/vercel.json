{
  "buildCommand": "npx prisma generate && next build",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/project-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/recurring-tasks",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/due-date-reminder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/overdue-tasks",
      "schedule": "0 6 * * *"
    }
  ]
}
