generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id        String    @id @default(uuid()) @db.Uuid
  clerkId   String    @unique
  email     String    @unique
  fullName  String?
  role      String    @default("qs")
  officeId  String?   @db.Uuid
  roleId    String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  office             Office?       @relation(fields: [officeId], references: [id])
  customRole         Role?         @relation(fields: [roleId], references: [id])
  tasks               Task[]         @relation("TaskAssignee")
  reviewTasks         Task[]         @relation("TaskReviewer")
  attendance          Attendance[]
  queryRaised         TaskQueryLog[] @relation("QueryRaisedBy")
  queryReplied        TaskQueryLog[] @relation("QueryRespondedBy")
  createdRoles        Role[]         @relation("RoleCreatedBy")
  createdTemplates    ProjectTemplate[] @relation("TemplateCreatedBy")
  submittedWork       TaskSubmission[]  @relation("SubmissionBy")
  reviewedSubmissions TaskSubmission[]  @relation("SubmissionReviewedBy")
  projectMemberships  ProjectMember[]
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  officeId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office?         @relation(fields: [officeId], references: [id])
  tasks   Task[]
  members ProjectMember[]
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  addedAt   DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  title           String
  description     String?
  status          String         @default("ASSIGNED")
  plannedRate     Float?
  actualRate      Float?
  efficiency      Float?
  variance        Float?
  unit            String?
  tradeCode       String?
  assigneeId      String?        @db.Uuid
  reviewerId      String?        @db.Uuid
  submissionNote  String?
  reviewComment   String?
  reviewOutcome   String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  revisionCount   Int            @default(0)
  timeSpentMinute Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      UserProfile?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewer      UserProfile?     @relation("TaskReviewer", fields: [reviewerId], references: [id])
  logs          TaskTimeLog[]
  queries       TaskQueryLog[]
  attachments   TaskAttachment[]
  submissions   TaskSubmission[]
  productivity  TaskProductivity?
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  submissionId String?  @db.Uuid
  fileKey      String
  fileName     String
  mimeType     String?
  fileSize     Int?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission TaskSubmission? @relation(fields: [submissionId], references: [id])
}

model TaskSubmission {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @db.Uuid
  roundNumber    Int       @default(1)
  submittedById  String?   @db.Uuid
  submittedAt    DateTime  @default(now())
  submissionNote String?
  reviewedById   String?   @db.Uuid
  reviewedAt     DateTime?
  reviewComment  String?
  outcome        String    @default("PENDING")
  createdAt      DateTime  @default(now())

  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy UserProfile?    @relation("SubmissionBy", fields: [submittedById], references: [id])
  reviewedBy  UserProfile?    @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id])
  attachments TaskAttachment[]
}

model TaskTimeLog {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  officeId    String?  @db.Uuid
  workDate    DateTime
  checkInTime DateTime
  status      String
  reason      String?
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  office Office?     @relation(fields: [officeId], references: [id])

  @@unique([userId, workDate])
}

model Office {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique
  name           String
  city           String?
  country        String?
  managingUserId String?     @db.Uuid
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  users      UserProfile[]
  projects   Project[]
  attendance Attendance[]
}

model TaskQueryLog {
  id            String    @id @default(uuid()) @db.Uuid
  taskId         String    @db.Uuid
  drawingRef     String?
  description    String
  impact         String?
  raisedById     String?   @db.Uuid
  response       String?
  respondedById  String?   @db.Uuid
  respondedAt    DateTime?
  resolved       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raisedBy     UserProfile? @relation("QueryRaisedBy", fields: [raisedById], references: [id])
  respondedBy  UserProfile? @relation("QueryRespondedBy", fields: [respondedById], references: [id])
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  isSystemRole  Boolean  @default(false)
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy    UserProfile?       @relation("RoleCreatedBy", fields: [createdById], references: [id])
  users        UserProfile[]
  permissions  RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ProjectTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  category    String?
  isSystem    Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy UserProfile? @relation("TemplateCreatedBy", fields: [createdById], references: [id])
}

model TaskProductivity {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @unique @db.Uuid
  plannedRate    Float?
  actualRate     Float?
  efficiency     Float?
  variance       Float?
  unitOfMeasure  String?
  calculatedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
